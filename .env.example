# Database
MONGODB_URI=mongodb://localhost:27017/inventory-management

# Authentication Secrets (Generate new ones for production!)
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=your-nextauth-secret-here
JWT_SECRET=your-jwt-secret-here

# NextAuth Configuration
# For HTTP (development/testing):
NEXTAUTH_URL=http://inventory.spaceautotech.com
# For HTTPS (production):
# NEXTAUTH_URL=https://your-domain.com

# Node Environment
NODE_ENV=production

# Optional: Port configuration (default: 3000)
# PORT=3000

# Optional: MongoDB Atlas example
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/inventory-management?retryWrites=true&w=majority
